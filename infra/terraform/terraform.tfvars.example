# Bridge configuration. Copy to terraform.tfvars and fill in. Do not put the
# bot secret in this file. Terraform necessarily stores the secret in state, so
# use appropriately secured state storage; no backend is hardcoded here.
subscription_id       = "<your-subscription-id>"
app_name              = "<unique-app-name>"
storage_account_name  = "<globally-unique-storage-name>"
bot_app_id            = "<bot-entra-app-id>"
sre_agent_endpoint    = "https://<your-sre-agent>.<region>.azuresre.ai"
# The SRE Agent may be in another subscription in the same Entra tenant.
# Cross-tenant role assignment is not supported by this deployment.
sre_agent_resource_id = "/subscriptions/<subscription-guid>/resourceGroups/<rg>/providers/Microsoft.App/agents/<agent>"

# In PowerShell, provide the secret only to the Terraform child process:
# $secret = Read-Host -Prompt 'Bot app secret' -AsSecureString
# $env:TF_VAR_bot_app_secret = [Net.NetworkCredential]::new('', $secret).Password
# try { terraform apply } finally { Remove-Item Env:TF_VAR_bot_app_secret -ErrorAction SilentlyContinue }
